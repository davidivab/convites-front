# Public (browser) API base URL
NEXT_PUBLIC_API_URL=http://localhost:8095

# Server-side fetch used by Next SSR (explorar, centros, profesionales…).
# - npm run dev on your Mac → http://localhost:8095
# - front inside Docker → http://host.docker.internal:8095
API_URL=http://localhost:8095

# Host port published by docker-compose.yml
FRONT_PORT=3095
